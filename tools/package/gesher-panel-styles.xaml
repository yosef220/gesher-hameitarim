<!-- הסגנונות המשותפים לכל החלונות של מרכז הבקרה. New-PanelView (gesher-panel-view.ps1) מכניס
     אותם לחלון לפני הטעינה, אחרי הצבעים של המצב הנוכחי (gesher-tokens-<מצב>.xaml), ולכן
     StaticResource של מברשות Gesher* עובד כאן. הנימוקים: docs/he/design/01-design-plan.md -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- הגופנים. New-PanelView מחליף אותם בגופנים מ-ui-fonts כשהם קיימים. -->
    <FontFamily x:Key="PanelUiFont">Segoe UI</FontFamily>
    <FontFamily x:Key="PanelDisplayFont">Segoe UI</FontFamily>

    <!-- טבעת פוקוס, רק בניווט מקלדת -->
    <Style x:Key="PanelFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" RadiusX="8" RadiusY="8" SnapsToDevicePixels="True"
                               Stroke="{StaticResource GesherFocusBrush}" StrokeThickness="2"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- כפתור משני: המסגרת היא הגבול של שדה (line-strong) -->
    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource PanelUiFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="{StaticResource GesherSurfaceRaisedBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GesherLineStrongBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource GesherInkBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource PanelFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource GesherRadiusButton}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource GesherSurfaceHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource GesherLineBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource GesherFillDisabledBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource GesherLineBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource GesherInkDisabledBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- הפעולה הראשית. אחת לכל מסך -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource GesherBrandBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GesherBrandBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource GesherOnBrandBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource GesherBrandHoverBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource GesherBrandHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource GesherBrandPressedBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource GesherBrandPressedBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource GesherFillDisabledBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource GesherLineBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource GesherInkDisabledBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- אישור של פעולה הרסנית, רק בדיאלוג -->
    <Style x:Key="DangerActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource GesherDangerBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GesherDangerBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource GesherOnDangerBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource GesherDangerBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource GesherInkBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource GesherDangerBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource GesherInkBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- קישור טקסט שקט: פעולות משניות בשורה ובעמודת המערכת -->
    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource PanelUiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Padding" Value="0,2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource GesherBrandBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource PanelFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <TextBlock x:Name="Label" TextWrapping="Wrap"
                                   Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Label" Property="TextDecorations" Value="Underline"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource GesherInkDisabledBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="LinkDangerButton" TargetType="Button" BasedOn="{StaticResource LinkButton}">
        <Setter Property="Foreground" Value="{StaticResource GesherDangerBrush}"/>
    </Style>

    <!-- תיבת סימון: ריבוע ברדיוס 4, והטקסט נשבר לשורות -->
    <Style TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{DynamicResource PanelUiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource GesherInkBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource PanelFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="4" VerticalAlignment="Top" Margin="0,1,0,0"
                                Background="{StaticResource GesherSurfaceRaisedBrush}"
                                BorderBrush="{StaticResource GesherLineStrongBrush}" BorderThickness="1" SnapsToDevicePixels="True">
                            <Path x:Name="Mark" Data="M 3.5,9 L 7.2,12.6 L 14.5,5.2" Stroke="{StaticResource GesherOnBrandBrush}"
                                  StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Visibility="Collapsed" FlowDirection="LeftToRight"/>
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Top">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource GesherBrandBrush}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource GesherBrandBrush}"/>
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource GesherBrandBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource GesherInkDisabledBrush}"/>
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource GesherFillDisabledBrush}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource GesherLineBrush}"/>
                            <Setter TargetName="Mark" Property="Stroke" Value="{StaticResource GesherInkDisabledBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- שדה טקסט -->
    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource PanelUiFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource GesherInkBrush}"/>
        <Setter Property="CaretBrush" Value="{StaticResource GesherInkBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource GesherBrandBrush}"/>
        <Setter Property="Background" Value="{StaticResource GesherSurfaceRaisedBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GesherLineStrongBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource GesherRadiusButton}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Field" Property="BorderBrush" Value="{StaticResource GesherFocusBrush}"/>
                            <Setter TargetName="Field" Property="BorderThickness" Value="2"/>
                            <Setter TargetName="PART_ContentHost" Property="Margin" Value="7,5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- רשימה נפתחת (דיאלוג הפרוקסי), כדי שתתאים גם למצב כהה -->
    <Style x:Key="PanelComboToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Field" Background="{StaticResource GesherSurfaceRaisedBrush}"
                            BorderBrush="{StaticResource GesherLineStrongBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource GesherRadiusButton}" SnapsToDevicePixels="True">
                        <Path Data="M 0,0 L 4,4 L 8,0" Stroke="{StaticResource GesherInkMutedBrush}" StrokeThickness="1.5"
                              HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Field" Property="Background" Value="{StaticResource GesherSurfaceHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{DynamicResource PanelUiFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource GesherInkBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource PanelFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Style="{StaticResource PanelComboToggle}" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <ContentPresenter Margin="10,7,28,7" IsHitTestVisible="False" VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                            <Border Background="{StaticResource GesherSurfaceRaisedBrush}" BorderBrush="{StaticResource GesherLineStrongBrush}"
                                    BorderThickness="1" CornerRadius="{StaticResource GesherRadiusButton}" Padding="0,4"
                                    MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer>
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource GesherInkBrush}"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource GesherSurfaceHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource GesherSelectionBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- פס התקדמות דק: המותג על קו -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="3"/>
        <Setter Property="Foreground" Value="{StaticResource GesherBrandBrush}"/>
        <Setter Property="Background" Value="{StaticResource GesherLineBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- פס גלילה צר, שמתאים לשני המצבים -->
    <Style x:Key="PanelScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Grip" CornerRadius="4" Background="{StaticResource GesherLineStrongBrush}" Opacity="0.55"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Grip" Property="Opacity" Value="0.9"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Grip" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PanelScrollPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="12"/>
        <Setter Property="MinWidth" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Border Background="Transparent" Padding="2">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource PanelScrollPage}" Command="ScrollBar.PageUpCommand"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource PanelScrollThumb}" MinHeight="24"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource PanelScrollPage}" Command="ScrollBar.PageDownCommand"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="12"/>
                <Setter Property="MinHeight" Value="12"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Border Background="Transparent" Padding="2">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource PanelScrollPage}" Command="ScrollBar.PageLeftCommand"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource PanelScrollThumb}" MinWidth="24"/>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource PanelScrollPage}" Command="ScrollBar.PageRightCommand"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="FontFamily" Value="{DynamicResource PanelUiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="MaxWidth" Value="380"/>
        <Setter Property="Foreground" Value="{StaticResource GesherInkBrush}"/>
        <Setter Property="Background" Value="{StaticResource GesherSurfaceRaisedBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GesherLineStrongBrush}"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- סולם הטיפוגרפיה (ui/tokens.json) -->
    <Style x:Key="TextScreenTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource PanelDisplayFont}"/>
        <Setter Property="FontSize" Value="{StaticResource GesherTypeScreenTitleSize}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource GesherInkBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="TextListTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource GesherTypeListTitleSize}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource GesherInkBrush}"/>
    </Style>
    <Style x:Key="TextBody" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource GesherTypeBodySize}"/>
        <Setter Property="Foreground" Value="{StaticResource GesherInkBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="21"/>
    </Style>
    <Style x:Key="TextMuted" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource GesherInkMutedBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="19"/>
    </Style>
    <Style x:Key="TextCaption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource GesherTypeCaptionSize}"/>
        <Setter Property="Foreground" Value="{StaticResource GesherInkMutedBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
</ResourceDictionary>
