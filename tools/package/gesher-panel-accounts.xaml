<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="480" SizeToContent="Height" MaxHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FlowDirection="{DynamicResource PanelFlowDirection}"
        FontFamily="Segoe UI, Tahoma, Arial"
        Background="#FFFFFF">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D0D5DD"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#344054"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F2F4F7"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#1570EF"/>
            <Setter Property="BorderBrush" Value="#1570EF"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#175CD3"/>
                    <Setter Property="BorderBrush" Value="#175CD3"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DangerActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#D92D20"/>
            <Setter Property="BorderBrush" Value="#D92D20"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B42318"/>
                    <Setter Property="BorderBrush" Value="#B42318"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Border Padding="22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Name="DialogTitle" FontSize="16" FontWeight="Bold" Foreground="#101828"/>
            <TextBlock Grid.Row="1" Name="DialogMessage" FontSize="12" Foreground="#667085" TextWrapping="Wrap" Margin="0,4,0,12"/>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="320" Focusable="False">
                <StackPanel>
                    <TextBlock Name="AccountStatus" FontSize="13" Foreground="#667085" TextWrapping="Wrap"/>
                    <StackPanel Name="AccountList"/>
                </StackPanel>
            </ScrollViewer>

            <TextBlock Grid.Row="3" Name="AccountError" FontSize="12" Foreground="#D92D20" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>

            <Button Grid.Row="5" Name="BtnClose" IsCancel="True" IsDefault="True" MinWidth="85" HorizontalAlignment="Right"/>
        </Grid>
    </Border>
</Window>
