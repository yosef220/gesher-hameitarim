<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FlowDirection="{DynamicResource PanelFlowDirection}"
        FontFamily="{DynamicResource PanelUiFont}"
        FontSize="14"
        Foreground="{StaticResource GesherInkBrush}"
        Background="{StaticResource GesherSurfaceRaisedBrush}"
        UseLayoutRounding="True">
    <Border Padding="28,24,28,22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="{DynamicResource PanelBadgeBackground}" VerticalAlignment="Top">
                    <TextBlock Text="{DynamicResource PanelMessageSymbol}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource PanelBadgeForeground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ScrollViewer Name="DialogMessageScroll" Grid.Column="2" MaxHeight="400" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <TextBlock Name="DialogMessage" Style="{StaticResource TextBody}" VerticalAlignment="Center" Margin="0,5,0,0"/>
                </ScrollViewer>
            </Grid>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Name="BtnOk" IsDefault="True" IsCancel="True" MinWidth="92"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
