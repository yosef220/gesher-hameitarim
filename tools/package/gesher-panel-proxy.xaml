<!-- הפרוקסי של כל האפליקציות או של אפליקציה אחת (Show-ProxyDialog ב-gesher-control-panel.ps1).
     עד העיצוב מחדש הוא היה כתוב בתוך הסקריפט. השמות של הרכיבים הם החוזה עם הקוד. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="500" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FlowDirection="{DynamicResource PanelFlowDirection}"
        FontFamily="{DynamicResource PanelUiFont}"
        FontSize="14"
        Foreground="{DynamicResource GesherInkBrush}"
        Background="{DynamicResource GesherSurfaceRaisedBrush}"
        UseLayoutRounding="True">
    <Border Padding="28,24,28,22">
        <StackPanel>
            <TextBlock Name="DialogHeading" Style="{StaticResource TextScreenTitle}"/>
            <TextBlock Name="DialogPackage" Style="{StaticResource TextCaption}" FlowDirection="LeftToRight" HorizontalAlignment="Left" Margin="0,2,0,0"/>
            <TextBlock Name="DialogDetail" Style="{StaticResource TextMuted}" Margin="0,12,0,18"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ComboBox Name="DialogProxyMode" Grid.Column="0"/>
                <TextBox Name="DialogProxyAddress" Grid.Column="2" FlowDirection="LeftToRight"/>
            </Grid>
            <TextBlock Name="DialogError" Style="{StaticResource TextMuted}" Foreground="{StaticResource GesherDangerBrush}" Margin="0,10,0,0" Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button Name="BtnSave" IsDefault="True" Style="{StaticResource PrimaryButton}" MinWidth="92"/>
                <Border Width="8"/>
                <Button Name="BtnCancel" IsCancel="True" MinWidth="92"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
