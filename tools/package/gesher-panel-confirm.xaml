<!-- גשר המיתרים: דיאלוג אישור ופרטי אפליקציה. כותרת ב-David Libre, הסבר קצר, ופעולה ראשית אחת.
     הצבעים והסגנונות מגיעים מ-New-PanelView (gesher-panel-view.ps1). -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FlowDirection="{DynamicResource PanelFlowDirection}"
        FontFamily="{DynamicResource PanelUiFont}"
        FontSize="14"
        Foreground="{StaticResource GesherInkBrush}"
        Background="{StaticResource GesherSurfaceRaisedBrush}"
        UseLayoutRounding="True">
    <Border Padding="28,24,28,22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Name="IconContainer" Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="{DynamicResource PanelBadgeBackground}" VerticalAlignment="Center">
                    <Image Name="AppIconImage" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Name="DialogTitle" Style="{StaticResource TextScreenTitle}"/>
                    <TextBlock Name="DialogSubTitle" Style="{StaticResource TextCaption}" FlowDirection="LeftToRight" HorizontalAlignment="Left" Margin="0,2,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1">
                <TextBlock Name="DialogMessage" Style="{StaticResource TextBody}" FontWeight="Medium" Margin="0,0,0,6"/>
                <TextBlock Name="DialogDetail" Style="{StaticResource TextMuted}" Visibility="Collapsed"/>
                <StackPanel Name="SwitchPanel" Margin="0,18,0,0" Visibility="Collapsed">
                    <Border Height="1" Background="{StaticResource GesherLineBrush}" Margin="0,0,0,14"/>
                    <TextBlock Name="SwitchTitle" Style="{StaticResource TextBody}" FontWeight="Medium" Margin="0,0,0,8"/>
                    <TextBlock Name="SwitchStatus" Style="{StaticResource TextMuted}" Visibility="Collapsed"/>
                    <StackPanel Name="SwitchList"/>
                    <TextBlock Name="SwitchError" Style="{StaticResource TextMuted}" Foreground="{StaticResource GesherDangerBrush}" Margin="0,8,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </StackPanel>

            <!-- הסדר של Windows: האישור קודם, ואחריו הביטול, בקצה של השורה -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Name="BtnConfirm" Style="{DynamicResource PanelConfirmStyle}" IsDefault="True" MinWidth="92"/>
                <Border Width="8"/>
                <Button Name="BtnCancel" IsCancel="True" MinWidth="92"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
